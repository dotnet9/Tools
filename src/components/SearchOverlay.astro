<div class="overlay" id="overlay">
  <div class="omni" role="dialog" aria-modal="true" aria-label="站内搜索">
    <div class="in">
      <span aria-hidden="true" class="muted">⌕</span>
      <input id="omniInput" type="search" placeholder="搜索工具名、描述、slug 或分类…" autocomplete="off" />
      <span class="kbd">Esc</span>
    </div>
    <div class="res" id="omniRes"></div>
    <div class="foot">
      <span><span class="kbd">↑</span><span class="kbd">↓</span> 选择</span>
      <span><span class="kbd">Enter</span> 打开</span>
      <span><span class="kbd">/</span> 快速聚焦</span>
      <span id="omniCount" style="margin-left:auto"></span>
    </div>
  </div>
</div>
