---
import BaseLayout from '../layouts/BaseLayout.astro';
import { TOTAL_TOOLS } from '../lib/tools';
---

<BaseLayout title="页面不存在 · 码坊工具箱">
  <div class="empty" style="margin-top:60px">
    <div class="big">🧭</div>
    <h3>这个地址没有对应工具</h3>
    <p>共 {TOTAL_TOOLS} 个工具，可能你输入的 slug 有误，或者这个工具还没实现</p>
    <div class="acts">
      <a class="btn btn-primary" href="/tools/">浏览全部工具</a>
      <a class="btn btn-ghost" href="/search/">搜索工具</a>
      <a class="btn btn-ghost" href="/">回到首页</a>
    </div>
  </div>
</BaseLayout>
