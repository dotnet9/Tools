---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="我的收藏 · 码坊工具箱" active="favorites" description="收藏的工具保存在本机浏览器（localStorage），不需要账号，也不会同步到其它设备。">
  <div class="crumb-bar">
    <a href="/">码坊工具箱</a><span class="sep">/</span><span>收藏</span>
  </div>
  <div class="sec-head">
    <h2>我的收藏</h2><span class="en">Favorites</span>
    <p>保存在本机浏览器（localStorage），换设备不会同步</p>
    <button class="more" type="button" id="favClear" style="border:0">清空收藏</button>
  </div>
  <div id="favBody"></div>
</BaseLayout>

<script>
  const index = JSON.parse(document.getElementById('toolIndex')?.textContent ?? '[]') as {
    s: string;
    n: string;
    m: string;
    c: string;
    x: string;
  }[];
  const map = new Map(index.map((t) => [t.s, t]));
  const body = document.getElementById('favBody')!;

  const render = () => {
    let favs: string[] = [];
    try {
      favs = JSON.parse(localStorage.getItem('codewf-tools.favorites') ?? '[]');
    } catch {
      favs = [];
    }
    const rows = favs.map((s) => map.get(s)).filter(Boolean) as typeof index;
    if (!rows.length) {
      body.innerHTML = `
        <div class="empty">
          <div class="big">☆</div>
          <h3>还没有收藏工具</h3>
          <p>在工具卡片右上角点 ☆ 即可收藏，收藏会保存在这台设备上</p>
          <div class="acts"><a class="btn btn-primary" href="/tools/">去浏览全部工具</a></div>
        </div>`;
      return;
    }
    body.innerHTML = `<div class="stack">${rows
      .map(
        (t) => `<div class="list-card" style="--c:${t.x}">
          <span class="dot"></span>
          <div class="info"><a href="/${t.s}/"><b>${t.n.replace(/[&<>"]/g, '')}</b></a><p>${t.m.replace(/[&<>"]/g, '')}</p></div>
          <span class="tag">${t.c.replace(/[&<>"]/g, '')}</span>
          <button class="btn btn-ghost btn-sm" type="button" data-fav="${t.s}">★ 已收藏</button>
        </div>`,
      )
      .join('')}</div>`;
  };

  render();
  window.addEventListener('favorites-change', render);
  document.getElementById('favClear')?.addEventListener('click', () => {
    try {
      localStorage.setItem('codewf-tools.favorites', '[]');
    } catch {}
    window.dispatchEvent(new Event('favorites-change'));
  });
</script>
